<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="quadtailsitter_joint_gimbal_training">
    <include merge="true">
      <uri>model://quadtailsitter</uri>
    </include>
    <include merge="true">
      <uri>model://training_joint_gimbal</uri>
      <pose relative_to="base_link">0.75 0.0 1.1 1.5707963267948966 0.0 3.14</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>cgo3_mount_link</child>
      <pose relative_to="base_link">0.75 0.0 1.1 1.5707963267948966 0.0 3.14</pose>
    </joint>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>-1</update_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>cgo3_vertical_arm_joint</joint_name>
      <joint_name>cgo3_horizontal_arm_joint</joint_name>
      <joint_name>cgo3_camera_joint</joint_name>
    </plugin>
  </model>
</sdf>