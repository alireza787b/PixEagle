<?xml version="1.0"?>
<sdf version="1.10">
  <model name="quadtailsitter_nose_cam">
    <include merge="true"><uri>model://quadtailsitter</uri></include>
    <include merge="true">
      <uri>model://mono_cam</uri>
      <pose relative_to="base_link">0 0 0.34 0 -1.5707963267948966 0</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent><child>camera_link</child>
      <pose relative_to="base_link">0 0 0.34 0 -1.5707963267948966 0</pose>
    </joint>
  </model>
</sdf>
