+	EXPECT_FALSE(advanceOwnedModeRevision(revision));
+	EXPECT_EQ(revision, std::numeric_limits<uint64_t>::max());
+	EXPECT_FALSE(advanceOwnedModeRevision(revision));
+	EXPECT_EQ(revision, std::numeric_limits<uint64_t>::max());
+}
