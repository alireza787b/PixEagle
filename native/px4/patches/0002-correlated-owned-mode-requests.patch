+// SPDX-License-Identifier: BSD-3-Clause
+#include "OwnedModeGuard.hpp"
+#include <gtest/gtest.h>
+
+namespace
+{
+using namespace px4;
+constexpr uint8_t Hold = 4, External = 23;
+const OwnedModeToken Incarnation{10, 11}, Token{20, 21};
+
+struct Fixture {
+	OwnedModeGuard guard;
+	OwnedModeIntention intention;
+	OwnedModeObservation observation{Hold, 100, true, false, 9000};
+	OwnedModeRequest acquisition{OwnedModeOperation::Acquire, Incarnation, Token, 0, 100, 0, 1000, 501000, Hold, External, 9000};
+	Fixture() { guard.initialize(Incarnation); }
+	void acquire()
+	{
+		ASSERT_EQ(guard.request(acquisition, observation, intention, 1001, Hold), OwnedModeAction::Acquire);
+		intention.acceptedChange(Token);
+		guard.acquisitionRequested(true, intention);
+		observation = {External, 200, true, false, 9000};
+		guard.observe(observation, intention, 1002);
+		ASSERT_TRUE(guard.ownerActive(observation, intention));
+	}
+	OwnedModeRequest release() const
+	{
+		auto request = acquisition;
+		request.operation = OwnedModeOperation::Release;
+		request.acquired_epoch = guard.acquiredEpoch();
+		request.source_clock = 2000;
+		request.expires = 502000;
+		return request;
+	}
+};
+
+TEST(OwnedModeGuard, AcknowledgedIntentionDoesNotEstablishAcquisition)
+{
+	Fixture f;
+	EXPECT_EQ(f.guard.request(f.acquisition, f.observation, f.intention, 1001, Hold), OwnedModeAction::Acquire);
+	f.intention.acceptedChange(Token);
+	f.guard.acquisitionRequested(true, f.intention);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Pending);
+	EXPECT_EQ(f.guard.acquiredEpoch(), 0);
+	EXPECT_FALSE(f.guard.ownerActive(f.observation, f.intention));
+}
+
+TEST(OwnedModeGuard, ExplicitPilotSameIdSelectionCannotBeAdoptedWhilePending)
+{
+	Fixture f;
+	ASSERT_EQ(f.guard.request(f.acquisition, f.observation, f.intention, 1001, Hold), OwnedModeAction::Acquire);
+	f.intention.acceptedChange(Token);
+	f.guard.acquisitionRequested(true, f.intention);
+	f.intention.acceptedChange();
+	f.observation = {External, 200, true, false, 9000};
+	f.guard.observe(f.observation, f.intention, 1002);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Superseded);
+	EXPECT_EQ(f.guard.acquiredEpoch(), 0);
+	EXPECT_FALSE(f.guard.ownerActive(f.observation, f.intention));
+	EXPECT_EQ(f.guard.request(f.release(), f.observation, f.intention, 2001, Hold), OwnedModeAction::None);
+}
+
+TEST(OwnedModeGuard, SkippedOriginalActivationRetainsItsEpochAndNeverReleasesReplacement)
+{
+	Fixture f;
+	f.acquire(); // Firmware records 200 even if no adapter has received that status.
+	f.intention.acceptedChange();
+	f.observation = {Hold, 250, true, false, 9000};
+	f.guard.observe(f.observation, f.intention, 1003);
+	f.intention.acceptedChange();
+	f.observation = {External, 300, true, false, 9000};
+	f.guard.observe(f.observation, f.intention, 1004);
+	EXPECT_EQ(f.guard.acquiredEpoch(), 200);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Superseded);
+	EXPECT_FALSE(f.guard.ownerActive(f.observation, f.intention));
+	EXPECT_EQ(f.guard.request(f.release(), f.observation, f.intention, 2001, Hold), OwnedModeAction::None);
+}
+
+TEST(OwnedModeGuard, UnchangedObservationAndReadOnlyReconciliationPreserveOwner)
+{
+	Fixture f;
+	f.acquire();
+	const auto revision = f.intention.revision();
+
+	for (uint64_t time = 2000; time < 3000; ++time) {
+		EXPECT_EQ(f.guard.observe(f.observation, f.intention, time), OwnedModeAction::None);
+		EXPECT_EQ(f.intention.revision(), revision);
+		EXPECT_TRUE(f.guard.ownerActive(f.observation, f.intention));
+	}
+}
+
+TEST(OwnedModeGuard, SameOwnerReleaseConfirmsActualHoldAndIsIdempotent)
+{
+	Fixture f;
+	f.acquire();
+	const auto request = f.release();
+	ASSERT_EQ(f.guard.request(request, f.observation, f.intention, 2001, Hold), OwnedModeAction::Hold);
+	f.intention.acceptedChange();
+	f.guard.releaseRequested(true, f.intention);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Releasing);
+	EXPECT_EQ(f.guard.request(request, f.observation, f.intention, 2002, Hold), OwnedModeAction::None);
+	f.observation = {Hold, 400, true, false, 9000};
+	f.guard.observe(f.observation, f.intention, 2003);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Released);
+	EXPECT_EQ(f.guard.acquiredEpoch(), 200);
+	EXPECT_EQ(f.guard.request(request, f.observation, f.intention, 2004, Hold), OwnedModeAction::None);
+}
+
+TEST(OwnedModeGuard, CancellationBeforeAcquireLeavesTombstoneAndConsumesRevision)
+{
+	Fixture f;
+	const auto cancel = f.release();
+	EXPECT_EQ(f.guard.request(cancel, f.observation, f.intention, 2001, Hold), OwnedModeAction::None);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Cancelled);
+	EXPECT_GT(f.intention.revision(), f.acquisition.source_revision);
+	EXPECT_EQ(f.guard.request(f.acquisition, f.observation, f.intention, 2002, Hold), OwnedModeAction::None);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Cancelled);
+	EXPECT_EQ(f.guard.acquiredEpoch(), 0);
+}
+
+TEST(OwnedModeGuard, OldAcquireCannotReplayAfterOneReceiptWasReplaced)
+{
+	Fixture f;
+	f.guard.request(f.release(), f.observation, f.intention, 2001, Hold);
+	auto other = f.acquisition;
+	other.token = {30, 31};
+	other.source_revision = f.intention.revision();
+	EXPECT_EQ(f.guard.request(other, f.observation, f.intention, 2002, Hold), OwnedModeAction::Acquire);
+	f.intention.acceptedChange(other.token);
+	f.guard.acquisitionRequested(true, f.intention);
+	f.intention.acceptedChange();
+	f.guard.observe(f.observation, f.intention, 2003);
+	EXPECT_EQ(f.guard.request(f.acquisition, f.observation, f.intention, 2004, Hold), OwnedModeAction::None);
+	EXPECT_EQ(f.guard.acquisition().token, other.token);
+}
+
+TEST(OwnedModeGuard, PendingCancellationRestoresOnlyItsOwnStillCurrentIntention)
+{
+	Fixture f;
+	ASSERT_EQ(f.guard.request(f.acquisition, f.observation, f.intention, 1001, Hold), OwnedModeAction::Acquire);
+	f.intention.acceptedChange(Token);
+	f.guard.acquisitionRequested(true, f.intention);
+	EXPECT_EQ(f.guard.request(f.release(), f.observation, f.intention, 2001, Hold), OwnedModeAction::RestoreSource);
+	f.intention.acceptedChange();
+	EXPECT_EQ(f.guard.request(f.acquisition, f.observation, f.intention, 2002, Hold), OwnedModeAction::None);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Cancelled);
+}
+
+TEST(OwnedModeGuard, ExpiryBeforeActualActivationCannotCreateAnAcquisitionReceipt)
+{
+	Fixture f;
+	f.guard.request(f.acquisition, f.observation, f.intention, 1001, Hold);
+	f.intention.acceptedChange(Token);
+	f.guard.acquisitionRequested(true, f.intention);
+	EXPECT_EQ(f.guard.observe(f.observation, f.intention, f.acquisition.expires), OwnedModeAction::RestoreSource);
+	f.intention.acceptedChange();
+	f.observation = {External, 200, true, false, 9000};
+	f.guard.observe(f.observation, f.intention, 501001);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Expired);
+	EXPECT_EQ(f.guard.acquiredEpoch(), 0);
+}
+
+TEST(OwnedModeGuard, PreexistingExternalModeAndMalformedTimingCannotAcquire)
+{
+	for (int invalid = 0; invalid < 6; ++invalid) {
+		Fixture f;
+		auto request = f.acquisition;
+
+		if (invalid == 0) { f.observation = {External, 100, true, false, 9000}; request.source_mode = External; }
+
+		if (invalid == 1) { request.source_clock = 0; }
+
+		if (invalid == 2) { request.source_clock = 1002; }
+
+		if (invalid == 3) { request.expires = 1001; }
+
+		if (invalid == 4) { ++request.expires; }
+
+		if (invalid == 5) { request.incarnation[0]++; }
+
+		EXPECT_EQ(f.guard.request(request, f.observation, f.intention, 1001, Hold), OwnedModeAction::None);
+		EXPECT_EQ(f.guard.state(), OwnedModeState::Idle);
+		EXPECT_EQ(f.intention.revision(), 0);
+	}
+}
+
+TEST(OwnedModeGuard, TakeoverDisarmRescueAndSameIdRevisionLossFenceReleaseAtInvocation)
+{
+	for (int condition = 0; condition < 4; ++condition) {
+		Fixture f;
+		f.acquire();
+
+		if (condition == 0) { f.observation = {5, 300, true, false, 9000}; }
+
+		if (condition == 1) { f.observation.armed = false; }
+
+		if (condition == 2) { f.observation.rescue = true; }
+
+		if (condition == 3) { f.intention.acceptedChange(); }
+
+		f.guard.observe(f.observation, f.intention, 2001);
+		EXPECT_EQ(f.guard.request(f.release(), f.observation, f.intention, 2002, Hold), OwnedModeAction::None);
+		EXPECT_EQ(f.guard.state(), OwnedModeState::Superseded);
