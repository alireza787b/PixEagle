diff --git a/src/modules/commander/UserModeIntentionOwnedTest.cpp b/src/modules/commander/UserModeIntentionOwnedTest.cpp
new file mode 100644
index 00000000..e87c2143
--- /dev/null
+++ b/src/modules/commander/UserModeIntentionOwnedTest.cpp
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "UserModeIntention.hpp"
+#include <gtest/gtest.h>
+#include <px4_platform_common/px4_work_queue/WorkQueueManager.hpp>
+#include <px4_random.h>
+
+namespace
+{
+class ModeEvents : public ModeChangeHandler
+{
+public:
+	void onUserIntendedNavStateChange(ModeChangeSource, uint8_t mode) override { last_mode = mode; ++events; }
+	uint8_t getReplacedModeIfAny(uint8_t mode) override { return mode; }
+	uint8_t onDisarm(uint8_t mode) override { return mode; }
+	uint8_t last_mode{};
+	unsigned events{};
+};
+
+class WorkQueueRuntime
+{
+public:
+	WorkQueueRuntime() { EXPECT_EQ(px4::WorkQueueManagerStart(), 0); }
+	~WorkQueueRuntime() { px4::WorkQueueManagerStop(); }
+};
+
+struct Fixture {
+	WorkQueueRuntime work_queue;
+	vehicle_status_s status{};
+	HealthAndArmingChecks health{nullptr, status};
+	ModeEvents events;
+	UserModeIntention intention{status, health, &events};
+	const px4::OwnedModeToken token{1, 2};
+	Fixture()
+	{
+		status.arming_state = vehicle_status_s::ARMING_STATE_DISARMED;
+		status.nav_state = vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER;
+		status.nav_state_timestamp = 100;
+	}
+	void pending(uint8_t source = vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER)
+	{
+		ASSERT_TRUE(intention.change(source));
+		ASSERT_TRUE(intention.change(vehicle_status_s::NAVIGATION_STATE_EXTERNAL1, ModeChangeSource::User, false, false, token));
+	}
+};
+
+TEST(UserModeIntentionOwned, RollbackWithdrawsPendingIntentionWhenSourceCanNoLongerRun)
+{
+	Fixture f;
+	f.pending();
+	const auto revision = f.intention.ownedModeIntention().revision();
+	f.status.arming_state = vehicle_status_s::ARMING_STATE_ARMED;
+	// No fabricated health report: an unqualified source is ineligible in the real class.
+	ASSERT_FALSE(f.health.canRun(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER));
+	ASSERT_FALSE(f.intention.change(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER));
+	ASSERT_TRUE(f.intention.cancelOwnedChange(f.token, revision));
+	EXPECT_EQ(f.intention.get(), vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	EXPECT_FALSE(px4::validOwnedModeToken(f.intention.ownedModeIntention().token()));
+	// An intention rollback is not forced actual aircraft mode entry.
+	EXPECT_EQ(f.status.nav_state, vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	EXPECT_EQ(f.status.nav_state_timestamp, 100);
+}
+
+TEST(UserModeIntentionOwned, MissingSourceRegistrationCannotLeaveExpiredExternalIntentionPending)
+{
+	Fixture f;
+	f.status.nav_state = vehicle_status_s::NAVIGATION_STATE_EXTERNAL2;
+	f.pending(vehicle_status_s::NAVIGATION_STATE_EXTERNAL2);
+	const auto revision = f.intention.ownedModeIntention().revision();
+	f.status.arming_state = vehicle_status_s::ARMING_STATE_ARMED;
+	ASSERT_FALSE(f.health.canRun(vehicle_status_s::NAVIGATION_STATE_EXTERNAL2));
+	ASSERT_TRUE(f.intention.cancelOwnedChange(f.token, revision));
+	EXPECT_EQ(f.intention.get(), vehicle_status_s::NAVIGATION_STATE_EXTERNAL2);
+	EXPECT_NE(f.intention.get(), vehicle_status_s::NAVIGATION_STATE_EXTERNAL1);
+	EXPECT_EQ(f.status.nav_state, vehicle_status_s::NAVIGATION_STATE_EXTERNAL2);
+}
+
+TEST(UserModeIntentionOwned, AcceptedPilotRequestIncludingSameIdPreventsOldRollback)
+{
+	for (const auto pilot_mode : {vehicle_status_s::NAVIGATION_STATE_AUTO_RTL, vehicle_status_s::NAVIGATION_STATE_EXTERNAL1}) {
+		Fixture f;
+		f.pending();
+		const auto revision = f.intention.ownedModeIntention().revision();
+		ASSERT_TRUE(f.intention.change(pilot_mode));
+		EXPECT_FALSE(f.intention.cancelOwnedChange(f.token, revision));
+		EXPECT_EQ(f.intention.get(), pilot_mode);
+	}
+}
+
+TEST(UserModeIntentionOwned, ReadOnlyPollingDoesNotRetireTheCurrentToken)
+{
+	Fixture f;
+	f.pending();
+	const auto revision = f.intention.ownedModeIntention().revision();
+
+	for (unsigned iteration = 0; iteration < 100; ++iteration) {
+		f.intention.get();
+		f.intention.getHadModeChangeAndClear();
+		EXPECT_EQ(f.intention.ownedModeIntention().revision(), revision);
+		EXPECT_EQ(f.intention.ownedModeIntention().token(), f.token);
+	}
+}
+
+TEST(UserModeIntentionOwned, PendingDifferentIntentionOrExecutorIsNotAnAcquisitionSource)
+{
+	Fixture f;
+	ASSERT_TRUE(f.intention.change(vehicle_status_s::NAVIGATION_STATE_AUTO_MISSION));
+	EXPECT_FALSE(px4::ownedModeSourceSettled(f.status.nav_state, f.intention.get(), true));
+	ASSERT_TRUE(f.intention.change(f.status.nav_state));
+	EXPECT_FALSE(px4::ownedModeSourceSettled(f.status.nav_state, f.intention.get(), false));
+	EXPECT_TRUE(px4::ownedModeSourceSettled(f.status.nav_state, f.intention.get(), true));
+}
+
+TEST(UserModeIntentionOwned, PosixEntropyProviderReturnsFullNonzeroIncarnation)
+{
+	const auto incarnation = px4::makeOwnedModeIncarnation(px4_get_secure_random);
+	EXPECT_TRUE(px4::validOwnedModeToken(incarnation));
+	uint8_t out[16] {};
+	EXPECT_EQ(px4_get_secure_random(nullptr, sizeof(out)), 0);
+	EXPECT_EQ(px4_get_secure_random(out, 0), 0);
+}
+
+TEST(UserModeIntentionOwned, DeadlineCrossingUsesCanonicalIneligibleHoldWithoutFalseRelease)
+{
+	Fixture f;
+	px4::OwnedModeGuard guard;
+	const px4::OwnedModeToken incarnation{7, 8};
+	guard.initialize(incarnation);
+	px4::OwnedModeRequest request{px4::OwnedModeOperation::Acquire, incarnation, f.token,
+				      f.intention.ownedModeIntention().revision(), f.status.nav_state_timestamp, 0, 1000, 2000,
+				      f.status.nav_state, vehicle_status_s::NAVIGATION_STATE_EXTERNAL1, 9000};
+	px4::OwnedModeObservation observation{f.status.nav_state, f.status.nav_state_timestamp, true, false, 9000};
+	ASSERT_EQ(guard.request(request, observation, f.intention.ownedModeIntention(), 1001,
+				vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER), px4::OwnedModeAction::Acquire);
+	ASSERT_TRUE(f.intention.change(request.mode, ModeChangeSource::User, false, false, f.token));
+	guard.acquisitionRequested(true, f.intention.ownedModeIntention());
+	f.status.nav_state = request.mode;
+	f.status.nav_state_timestamp = request.expires;
+	f.status.arming_state = vehicle_status_s::ARMING_STATE_ARMED;
+	observation = {f.status.nav_state, f.status.nav_state_timestamp, true, false, 9000};
+	ASSERT_EQ(guard.observe(observation, f.intention.ownedModeIntention(), request.expires + 1), px4::OwnedModeAction::Hold);
+	const bool accepted = f.intention.change(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	ASSERT_FALSE(accepted);
+	guard.releaseRequested(accepted, f.intention.ownedModeIntention());
+	guard.observe(observation, f.intention.ownedModeIntention(), request.expires + 2);
+	EXPECT_EQ(guard.state(), px4::OwnedModeState::Releasing);
+	EXPECT_EQ(guard.acquiredEpoch(), request.expires);
+	EXPECT_FALSE(guard.terminal());
+	EXPECT_EQ(f.status.nav_state, request.mode);
+	EXPECT_EQ(f.intention.get(), request.mode);
+}
+} // namespace
