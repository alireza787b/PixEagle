new file mode 100644
index 00000000..92a86f99
--- /dev/null
+++ b/platforms/posix/src/px4/common/posix_random.c
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include <stddef.h>
+#include <px4_random.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+size_t px4_get_secure_random(uint8_t *out, size_t outlen)
+{
+	if (!out || outlen == 0) { return 0; }
+
+	const int descriptor = open("/dev/urandom", O_RDONLY | O_CLOEXEC);
+
+	if (descriptor < 0) { return 0; }
+
+	size_t received = 0;
+
+	while (received < outlen) {
+		const ssize_t count = read(descriptor, out + received, outlen - received);
+
+		if (count > 0) {
+			received += (size_t)count;
+
+		} else if (count < 0 && errno == EINTR) {
+			continue;
+
+		} else {
+			break;
+		}
+	}
+
+	close(descriptor);
+	return received;
+}
