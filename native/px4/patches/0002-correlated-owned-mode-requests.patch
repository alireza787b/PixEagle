+px4::OwnedModeObservation Commander::ownedModeObservation(uint8_t mode_id) const
+{
+	return {_vehicle_status.nav_state, _vehicle_status.nav_state_timestamp, isArmed(),
+		_vehicle_status.failsafe || _vehicle_status.failsafe_and_user_took_over
+		|| (_vehicle_status.is_vtol &&_vtol_vehicle_status.fixed_wing_system_failure),
+		_mode_management.externalModeRegistrationId(mode_id)};
+}
+
+void Commander::updateOwnedModeReceipt()
+{
+	auto &intention = _user_mode_intention.ownedModeIntention();
+	const auto previous_state = _owned_mode_guard.state();
+	const auto action = _owned_mode_guard.observe(ownedModeObservation(_owned_mode_guard.acquisition().mode), intention, hrt_absolute_time());
+
+	if (action == px4::OwnedModeAction::RestoreSource && intention.token() == _owned_mode_guard.acquisition().token) {
+		_user_mode_intention.cancelOwnedChange(_owned_mode_guard.acquisition().token, _owned_mode_guard.acceptedRevision());
+
+	} else if (action == px4::OwnedModeAction::Hold) {
+		// A deadline crossing may activate our exact tagged request between the two observations.
+		const bool accepted = _user_mode_intention.change(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+		_owned_mode_guard.releaseRequested(accepted, intention);
+	}
+
+	if (_owned_mode_guard.state() != previous_state) { _last_owned_mode_status = 0; }
+}
+
+void Commander::handleOwnedModeRequest()
+{
+	owned_mode_request_s message{};
+
+	if (!_owned_mode_request_sub.update(&message)
+	    || message.contract_version != owned_mode_request_s::CONTRACT_VERSION
+	    || message.target_system != _vehicle_status.system_id || message.target_component != _vehicle_status.component_id) { return; }
+
+	px4::OwnedModeRequest request{};
+	request.operation = static_cast<px4::OwnedModeOperation>(message.operation);
+	request.incarnation = {message.incarnation[0], message.incarnation[1]};
+	request.token = {message.token[0], message.token[1]};
+	request.source_revision = message.source_revision;
+	request.source_epoch = message.source_nav_state_timestamp;
+	request.source_mode = message.source_nav_state;
+	request.mode = message.mode_id;
+	request.registration_id = message.registration_id;
+	request.acquired_epoch = message.acquired_nav_state_timestamp;
+	request.source_clock = message.source_clock_us;
+	request.expires = message.expires_at_us;
+
+	if (request.operation == px4::OwnedModeOperation::Acquire
+	    && !px4::ownedModeSourceSettled(_vehicle_status.nav_state,
+					    _mode_management.getNavStateReplacementIfValid(_user_mode_intention.get(), false),
+					    _mode_management.modeExecutorInCharge() == ModeExecutors::AUTOPILOT_EXECUTOR_ID)) { return; }
+
+	auto &intention = _user_mode_intention.ownedModeIntention();
+	const auto action = _owned_mode_guard.request(request, ownedModeObservation(request.mode), intention,
+			    hrt_absolute_time(), vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+
+	if (action == px4::OwnedModeAction::Acquire) {
+		// The canonical PX4 eligibility check remains authoritative; no forced mode entry.
+		const bool accepted = _user_mode_intention.change(request.mode, ModeChangeSource::User, false, false, request.token);
+		_owned_mode_guard.acquisitionRequested(accepted, intention);
+
+	} else if (action == px4::OwnedModeAction::Hold) {
+		const bool accepted = _user_mode_intention.change(vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+		_owned_mode_guard.releaseRequested(accepted, intention);
+
+	} else if (action == px4::OwnedModeAction::RestoreSource && intention.token() == request.token) {
+		_user_mode_intention.cancelOwnedChange(request.token, _owned_mode_guard.acceptedRevision());
+	}
+
+	_last_owned_mode_status = 0;
+}
+
+void Commander::publishOwnedModeStatus()
+{
+	const hrt_abstime now = hrt_absolute_time();
+
+	// A real source-clock heartbeat in the existing loop, not a new timer or query stamp.
+	if (_last_owned_mode_status != 0 && now - _last_owned_mode_status < 100_ms) { return; }
+
+	owned_mode_status_s message{};
+	message.timestamp = now;
+	message.contract_version = owned_mode_status_s::CONTRACT_VERSION;
+	auto &intention = _user_mode_intention.ownedModeIntention();
+	message.available = _owned_mode_guard.available(intention);
+	uuid_uint32_t uid;
+	board_get_uuid32(uid);
+	message.autopilot_uid = (static_cast<uint64_t>(uid[PX4_CPU_UUID_WORD32_UNIQUE_M]) << 32) | uid[PX4_CPU_UUID_WORD32_UNIQUE_H];
+#ifdef CONFIG_ARCH_BOARD_PX4_SITL
+	message.autopilot_uid += _vehicle_status.system_id - 1;
+#endif
+	message.system_id = _vehicle_status.system_id;
+	message.component_id = _vehicle_status.component_id;
+	const auto &incarnation = _owned_mode_guard.incarnation();
+	message.incarnation[0] = incarnation[0];
+	message.incarnation[1] = incarnation[1];
+	message.source_clock_us = now;
+	message.intention_revision = intention.revision();
+
+	for (uint8_t index = 0; index < px4::OwnedModeGuard::ExternalModeCount; ++index) {
+		message.registration_ids[index] = _mode_management.externalModeRegistrationId(px4::OwnedModeGuard::FirstExternalMode + index);
+	}
+
+	message.state = static_cast<uint8_t>(_owned_mode_guard.state());
+	const auto &acquisition = _owned_mode_guard.acquisition();
+	message.token[0] = acquisition.token[0];
+	message.token[1] = acquisition.token[1];
+	message.source_revision = acquisition.source_revision;
+	message.source_nav_state = acquisition.source_mode;
+	message.source_nav_state_timestamp = acquisition.source_epoch;
+	message.mode_id = acquisition.mode;
+	message.registration_id = acquisition.registration_id;
+	message.acquired_nav_state_timestamp = _owned_mode_guard.acquiredEpoch();
+	const auto observation = ownedModeObservation(acquisition.mode);
+	message.owner_active = _owned_mode_guard.ownerActive(observation, intention);
+	message.nav_state = observation.mode;
+	message.nav_state_timestamp = observation.epoch;
+	message.armed = observation.armed;
+	message.rescue_active = observation.rescue;
+	_owned_mode_status_pub.publish(message);
+	_last_owned_mode_status = now;
+}
