+	guard.initialize({});
+	EXPECT_FALSE(guard.available(intention));
+	guard.initialize(Incarnation);
+	EXPECT_FALSE(guard.available(intention));
+}
+
+TEST(OwnedModeGuard, FullNonzeroEntropyIsRequiredForTheExact128BitIncarnation)
+{
+	const auto good = makeOwnedModeIncarnation([](uint8_t *out, size_t length) {
+		for (size_t index = 0; index < length; ++index) { out[index] = static_cast<uint8_t>(index + 1); }
+
+		return length;
+	});
+	EXPECT_TRUE(validOwnedModeToken(good));
+	const auto short_read = makeOwnedModeIncarnation([](uint8_t *out, size_t length) {
+		for (size_t index = 0; index < length; ++index) { out[index] = 1; }
+
+		return length - 1;
+	});
+	EXPECT_FALSE(validOwnedModeToken(short_read));
+	const auto zero = makeOwnedModeIncarnation([](uint8_t *, size_t length) { return length; });
+	EXPECT_FALSE(validOwnedModeToken(zero));
+}
