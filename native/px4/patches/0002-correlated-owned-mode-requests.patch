+TEST(OwnedModeGuard, RegistrationReplacementWithdrawsPendingAcquisitionAndNeverAdoptsItsMode)
+{
+	Fixture f;
+	f.guard.request(f.acquisition, f.observation, f.intention, 1001, Hold);
+	f.intention.acceptedChange(Token);
+	f.guard.acquisitionRequested(true, f.intention);
+	f.observation.registration_id = 0;
+	EXPECT_EQ(f.guard.observe(f.observation, f.intention, 1002), OwnedModeAction::RestoreSource);
+	f.intention.acceptedChange();
+	f.observation = {External, 200, true, false, 9001};
+	f.guard.observe(f.observation, f.intention, 1003);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Superseded);
+	EXPECT_EQ(f.guard.acquiredEpoch(), 0);
+	EXPECT_FALSE(f.guard.ownerActive(f.observation, f.intention));
+}
+
+TEST(OwnedModeGuard, RepeatedAcquisitionCannotRefreshTheOriginalNativeDeadline)
+{
+	Fixture f;
+	f.guard.request(f.acquisition, f.observation, f.intention, 1001, Hold);
+	f.intention.acceptedChange(Token);
+	f.guard.acquisitionRequested(true, f.intention);
+	auto repeated = f.acquisition;
+	repeated.source_clock += 1000;
+	repeated.expires += 1000;
+	EXPECT_EQ(f.guard.request(repeated, f.observation, f.intention, 2001, Hold), OwnedModeAction::None);
+	EXPECT_EQ(f.guard.acquisition().expires, f.acquisition.expires);
+	EXPECT_EQ(f.guard.observe(f.observation, f.intention, f.acquisition.expires), OwnedModeAction::RestoreSource);
+}
+
+TEST(OwnedModeGuard, TimelyActualActivationIsRecordedEvenWhenObservedAfterDeadline)
+{
+	Fixture f;
+	f.guard.request(f.acquisition, f.observation, f.intention, 1001, Hold);
+	f.intention.acceptedChange(Token);
+	f.guard.acquisitionRequested(true, f.intention);
+	f.observation = {External, f.acquisition.expires - 1, true, false, 9000};
+	EXPECT_EQ(f.guard.observe(f.observation, f.intention, f.acquisition.expires + 100), OwnedModeAction::None);
+	EXPECT_EQ(f.guard.acquiredEpoch(), f.acquisition.expires - 1);
+	EXPECT_TRUE(f.guard.ownerActive(f.observation, f.intention));
+}
+
+TEST(OwnedModeGuard, ActivationCrossingDeadlineRemainsUnconfirmedUntilActualHold)
+{
+	for (const uint64_t offset : {0, 1}) {
+		Fixture f;
+		f.guard.request(f.acquisition, f.observation, f.intention, 1001, Hold);
+		f.intention.acceptedChange(Token);
+		f.guard.acquisitionRequested(true, f.intention);
+		EXPECT_EQ(f.guard.observe(f.observation, f.intention, f.acquisition.expires - 1), OwnedModeAction::None);
+		f.observation = {External, f.acquisition.expires + offset, true, false, 9000};
+		EXPECT_EQ(f.guard.observe(f.observation, f.intention, f.acquisition.expires + 100), OwnedModeAction::Hold);
+		EXPECT_EQ(f.guard.acquiredEpoch(), f.acquisition.expires + offset);
+		EXPECT_EQ(f.guard.state(), OwnedModeState::Releasing);
+		EXPECT_FALSE(f.guard.ownerActive(f.observation, f.intention));
+		// Ineligible Hold keeps the exact activation unresolved, not terminal/already released.
+		f.guard.releaseRequested(false, f.intention);
+		f.guard.observe(f.observation, f.intention, f.acquisition.expires + 101);
+		EXPECT_EQ(f.guard.state(), OwnedModeState::Releasing);
+		EXPECT_FALSE(f.guard.terminal());
+		auto release = f.release();
+		release.source_clock = f.acquisition.expires + 102;
+		release.expires = release.source_clock + 1000;
+		EXPECT_EQ(f.guard.request(release, f.observation, f.intention, release.source_clock, Hold), OwnedModeAction::Hold);
+		f.intention.acceptedChange();
+		f.guard.releaseRequested(true, f.intention);
+		f.observation = {Hold, release.source_clock + 1, true, false, 9000};
+		f.guard.observe(f.observation, f.intention, release.source_clock + 2);
+		EXPECT_EQ(f.guard.state(), OwnedModeState::Released);
+	}
+}
+
+TEST(OwnedModeGuard, DeadlineCrossingNeverReleasesPilotSameIdActivation)
+{
+	Fixture f;
+	f.guard.request(f.acquisition, f.observation, f.intention, 1001, Hold);
+	f.intention.acceptedChange(Token);
+	f.guard.acquisitionRequested(true, f.intention);
+	f.intention.acceptedChange();
+	f.observation = {External, f.acquisition.expires, true, false, 9000};
+	EXPECT_EQ(f.guard.observe(f.observation, f.intention, f.acquisition.expires + 100), OwnedModeAction::None);
+	EXPECT_EQ(f.guard.state(), OwnedModeState::Superseded);
+	EXPECT_EQ(f.guard.acquiredEpoch(), 0);
+}
+} // namespace
