+
+inline bool validOwnedModeToken(const OwnedModeToken &token)
+{
+	return token[0] != 0 || token[1] != 0;
+}
+
+inline bool ownedModeSourceSettled(uint8_t actual_mode, uint8_t effective_intention, bool autopilot_in_charge)
+{
+	return actual_mode == effective_intention && autopilot_in_charge;
+}
+
+inline bool advanceOwnedModeRevision(uint64_t &revision)
+{
+	if (revision == std::numeric_limits<uint64_t>::max()) { return false; }
+
+	++revision;
+	return revision != std::numeric_limits<uint64_t>::max();
+}
+
+template<typename RandomProvider>
+OwnedModeToken makeOwnedModeIncarnation(RandomProvider provider)
+{
+	OwnedModeToken incarnation{};
+
+	if (provider(reinterpret_cast<uint8_t *>(incarnation.data()), sizeof(incarnation)) != sizeof(incarnation)
+	    || !validOwnedModeToken(incarnation)) { return {}; }
+
+	return incarnation;
+}
+
+// Correlation belongs to the existing intention, not a second control owner.
+class OwnedModeIntention
+{
+public:
+	uint64_t revision() const { return _revision; }
+	const OwnedModeToken &token() const { return _token; }
+	bool available() const { return _revision != std::numeric_limits<uint64_t>::max(); }
+
+	void acceptedChange(const OwnedModeToken &token = {})
+	{
+		_token = advanceOwnedModeRevision(_revision) ? token : OwnedModeToken{};
+	}
+
+	bool consume(uint64_t expected_revision)
+	{
+		if (!available() || expected_revision != _revision || validOwnedModeToken(_token)) { return false; }
+
+		acceptedChange();
+		return available();
+	}
+
+private:
+	uint64_t _revision{};
+	OwnedModeToken _token{};
+};
+
+enum class OwnedModeOperation : uint8_t { Acquire = 1, Release = 2 };
+enum class OwnedModeState : uint8_t { Idle, Pending, Acquired, Releasing, Released, Cancelled, Rejected, Expired, Superseded };
+enum class OwnedModeAction { None, Acquire, Hold, RestoreSource };
+
+struct OwnedModeRequest {
+	OwnedModeOperation operation{};
+	OwnedModeToken incarnation{}, token{};
+	uint64_t source_revision{}, source_epoch{}, acquired_epoch{}, source_clock{}, expires{};
+	uint8_t source_mode{}, mode{};
+	uint64_t registration_id{};
+
+	bool sameAcquisition(const OwnedModeRequest &other) const
+	{
+		return incarnation == other.incarnation && token == other.token && source_revision == other.source_revision
+		       && source_epoch == other.source_epoch && source_mode == other.source_mode && mode == other.mode
+		       && registration_id == other.registration_id;
+	}
+
+	bool operator==(const OwnedModeRequest &other) const
+	{
+		return sameAcquisition(other) && operation == other.operation && acquired_epoch == other.acquired_epoch
+		       && source_clock == other.source_clock && expires == other.expires;
+	}
+};
+
+struct OwnedModeObservation {
+	uint8_t mode{};
+	uint64_t epoch{};
+	bool armed{}, rescue{};
+	uint64_t registration_id{};
+};
+
+// A bounded causal receipt. It cannot publish a setpoint or establish a lease.
+class OwnedModeGuard
+{
+public:
+	static constexpr uint64_t MaximumRequestWindowUs = 500000;
+	static constexpr uint8_t FirstExternalMode = 23, LastExternalMode = 30;
+	static constexpr uint8_t ExternalModeCount = LastExternalMode - FirstExternalMode + 1;
+
+	void initialize(const OwnedModeToken &incarnation)
+	{
+		if (_initialized) { return; }
+
+		_initialized = true;
+		_incarnation = incarnation;
+	}
+	bool available(const OwnedModeIntention &intention) const { return validOwnedModeToken(_incarnation) && intention.available(); }
+	const OwnedModeToken &incarnation() const { return _incarnation; }
+	OwnedModeState state() const { return _state; }
+	const OwnedModeRequest &acquisition() const { return _acquisition; }
+	uint64_t acquiredEpoch() const { return _acquired_epoch; }
+	uint64_t acceptedRevision() const { return _accepted_revision; }
+
+	bool ownerActive(const OwnedModeObservation &observation, const OwnedModeIntention &intention) const
+	{
+		return _state == OwnedModeState::Acquired && matchesActivation(observation)
+		       && intention.token() == _acquisition.token && intention.revision() == _accepted_revision
+		       && observation.registration_id == _acquisition.registration_id && observation.armed && !observation.rescue;
+	}
+
+	bool validTime(const OwnedModeRequest &request, uint64_t now) const
+	{
+		return request.source_clock > 0 && request.source_clock <= now && request.expires > now
+		       && request.expires > request.source_clock
+		       && request.expires - request.source_clock <= MaximumRequestWindowUs;
+	}
+
+	OwnedModeAction request(const OwnedModeRequest &request, const OwnedModeObservation &observation,
+				OwnedModeIntention &intention, uint64_t now, uint8_t hold_mode)
+	{
+		if (!available(intention) || request.incarnation != _incarnation || !validOwnedModeToken(request.token)
+		    || (request.operation != OwnedModeOperation::Acquire && request.operation != OwnedModeOperation::Release)
+		    || (request.operation == OwnedModeOperation::Acquire && request.acquired_epoch != 0)
+		    || request.mode < FirstExternalMode || request.mode > LastExternalMode) { return OwnedModeAction::None; }
+
+		if (request.token == _acquisition.token && _state != OwnedModeState::Idle) {
+			if (!request.sameAcquisition(_acquisition)) { return OwnedModeAction::None; }
+
+			if (request.operation == OwnedModeOperation::Acquire) {
+				// Repeated acquire is observation only, including after cancellation.
+				return OwnedModeAction::None;
+			}
+
+			if ((_release_seen && !((_state == OwnedModeState::Acquired || _state == OwnedModeState::Releasing) && _release == request))
+			    || terminal() || !validTime(request, now)
+			    || (request.acquired_epoch != 0 && request.acquired_epoch != _acquired_epoch)) { return OwnedModeAction::None; }
+
+			// An accepted Hold is already under native arbitration; a duplicate cannot
+			// reinterpret it as an unrelated takeover or issue it again.
+			if (_state == OwnedModeState::Releasing
+			    && (intention.token() != _acquisition.token || intention.revision() != _release_revision)) {
+				return OwnedModeAction::None;
+			}
+
+			_release_seen = true;
+			_release = request;
+
+			if (ownerActive(observation, intention)
+			    || (_state == OwnedModeState::Releasing && matchesActivation(observation)
+				&& intention.token() == _acquisition.token && intention.revision() == _release_revision
+				&& observation.registration_id == _acquisition.registration_id && observation.armed && !observation.rescue)) {
+				_state = OwnedModeState::Releasing;
+				_hold_mode = hold_mode;
+				return OwnedModeAction::Hold;
+			}
+
+			if (_state == OwnedModeState::Pending && intention.token() == _acquisition.token
+			    && intention.revision() == _accepted_revision && matchesSource(observation)) {
+				_state = OwnedModeState::Cancelled;
+				return OwnedModeAction::RestoreSource;
+			}
+
+			_state = OwnedModeState::Superseded;
+			return OwnedModeAction::None;
+		}
+
+		if (!terminal() || !validTime(request, now) || !observation.armed || observation.rescue
+		    || request.registration_id == 0 || request.registration_id != observation.registration_id
+		    || !matchesSource(request, observation) || request.source_mode == request.mode
+		    || !intention.consume(request.source_revision)) { return OwnedModeAction::None; }
+
+		_acquisition = request;
+		_acquisition.operation = OwnedModeOperation::Acquire;
+		_acquired_epoch = 0;
+		_accepted_revision = 0;
+		_release_revision = 0;
+		_release_seen = request.operation == OwnedModeOperation::Release;
+		_hold_mode = hold_mode;
+		_state = _release_seen ? OwnedModeState::Cancelled : OwnedModeState::Pending;
+		return _release_seen ? OwnedModeAction::None : OwnedModeAction::Acquire;
+	}
+
+	void acquisitionRequested(bool accepted, const OwnedModeIntention &intention)
+	{
+		if (_state != OwnedModeState::Pending) { return; }
+
+		_accepted_revision = intention.revision();
+
+		if (!accepted || intention.token() != _acquisition.token) { _state = OwnedModeState::Rejected; }
+	}
+
+	void releaseRequested(bool accepted, const OwnedModeIntention &intention)
+	{
+		if (_state != OwnedModeState::Releasing) { return; }
+
+		_release_revision = intention.revision();
+
+		if (!accepted && _acquired_epoch < _acquisition.expires) { _state = OwnedModeState::Acquired; }
+	}
+
+	OwnedModeAction observe(const OwnedModeObservation &observation, const OwnedModeIntention &intention, uint64_t now)
+	{
+		if (_state == OwnedModeState::Pending) {
+			if (observation.registration_id != _acquisition.registration_id) {
+				_state = OwnedModeState::Superseded;
+				return intention.token() == _acquisition.token && matchesSource(observation)
+				       ? OwnedModeAction::RestoreSource : OwnedModeAction::None;
+
+			} else if (intention.token() != _acquisition.token || intention.revision() != _accepted_revision
+				   || !observation.armed || observation.rescue) {
+				_state = OwnedModeState::Superseded;
+
+			} else if (observation.mode == _acquisition.mode && observation.epoch > _acquisition.source_epoch) {
+				// The activation epoch, not the later receipt poll, decides native deadline validity.
+				_acquired_epoch = observation.epoch;
+				_state = _acquired_epoch < _acquisition.expires ? OwnedModeState::Acquired : OwnedModeState::Releasing;
+
+				if (_state == OwnedModeState::Releasing) { return OwnedModeAction::Hold; }
+
+			} else if (now >= _acquisition.expires) {
+				_state = OwnedModeState::Expired;
+				return matchesSource(observation) ? OwnedModeAction::RestoreSource : OwnedModeAction::None;
+
+			} else if (!matchesSource(observation)) {
+				_state = OwnedModeState::Superseded;
+			}
+
+		} else if (_state == OwnedModeState::Acquired && !ownerActive(observation, intention)) {
+			_state = OwnedModeState::Superseded;
+
+		} else if (_state == OwnedModeState::Releasing) {
+			if (intention.revision() != _release_revision || observation.rescue || !observation.armed
+			    || observation.registration_id != _acquisition.registration_id) {
+				_state = OwnedModeState::Superseded;
+
+			} else if (!matchesActivation(observation)) {
+				_state = observation.mode == _hold_mode && observation.epoch > _acquired_epoch
+					 ? OwnedModeState::Released : OwnedModeState::Superseded;
+			}
+		}
+
+		return OwnedModeAction::None;
+	}
+
+	bool terminal() const
+	{
+		return _state != OwnedModeState::Pending && _state != OwnedModeState::Acquired && _state != OwnedModeState::Releasing;
+	}
+
+private:
+	static bool matchesSource(const OwnedModeRequest &request, const OwnedModeObservation &observation)
+	{
+		return request.source_mode == observation.mode && request.source_epoch > 0 && request.source_epoch == observation.epoch;
+	}
+	bool matchesSource(const OwnedModeObservation &observation) const { return matchesSource(_acquisition, observation); }
+	bool matchesActivation(const OwnedModeObservation &observation) const
+	{
+		return _acquired_epoch > 0 && observation.mode == _acquisition.mode && observation.epoch == _acquired_epoch;
+	}
+	OwnedModeToken _incarnation{};
+	OwnedModeRequest _acquisition{}, _release{};
+	OwnedModeState _state{OwnedModeState::Idle};
+	uint64_t _accepted_revision{}, _release_revision{}, _acquired_epoch{};
+	uint8_t _hold_mode{};
+	bool _release_seen{};
+	bool _initialized{};
+};
+
+} // namespace px4
