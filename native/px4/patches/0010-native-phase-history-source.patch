diff --git a/src/modules/vtol_att_control/NativePhaseHistory.hpp b/src/modules/vtol_att_control/NativePhaseHistory.hpp
new file mode 100644
--- /dev/null
+++ b/src/modules/vtol_att_control/NativePhaseHistory.hpp
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+namespace px4
+{
+
+// One controller-owned history. Publishing or observing it cannot create events.
+class NativePhaseHistory
+{
+public:
+	explicit NativePhaseHistory(uint64_t instance) : _instance(instance), _revision(instance ? 1 : 0) {}
+	uint64_t instance() const { return _instance; }
+	uint64_t revision() const { return _revision; }
+	void advance()
+	{
+		if (_instance == 0 || _revision >= std::numeric_limits<uint64_t>::max() - 1) {
+			_instance = 0;
+			_revision = 0;
+
+		} else {
+			++_revision;
+		}
+	}
+private:
+	friend struct NativePhaseHistoryTestPeer;
+	uint64_t _instance{};
+	uint64_t _revision{};
+};
+
+} // namespace px4
