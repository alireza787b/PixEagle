+uint64_t nextPhaseSourceInstance()
+{
+	// Firmware incarnation covers process restart; this survives module restart and paused hrt.
+	static px4::atomic<uint32_t> next{1};
+	uint32_t value = next.load();
+
+	while (value != std::numeric_limits<uint32_t>::max()) {
+		if (next.compare_exchange(&value, value + 1)) { return value; }
+	}
+
+	return 0;
+}
+}
 
