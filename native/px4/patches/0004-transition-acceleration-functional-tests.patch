+TEST_F(TransitionAccelerationTest, AutoHandoverAcrossSignsStateFallbackAndVariableDt)
+{
+	struct Seed { float prior; float measured; };
+	const Seed seeds[] = {{-0.9f, 0.3f}, {0.f, 0.3f}, {0.9f, -0.3f},
+		{NAN, -0.4f}, {NAN, 0.f}, {NAN, 0.4f}
+	};
+	float acceleration_up = 0.f;
+	float acceleration_down = 0.f;
+	ASSERT_EQ(param_get(param_find("MPC_ACC_UP_MAX"), &acceleration_up), 0);
+	ASSERT_EQ(param_get(param_find("MPC_ACC_DOWN_MAX"), &acceleration_down), 0);
+	ASSERT_GT(acceleration_up, 0.f);
+	ASSERT_GT(acceleration_down, 0.f);
+
+	for (bool to_fw : {false, true}) {
+		for (const auto &seed : seeds) {
+			TransitionTestTask transition;
+			auto last = activate(transition, to_fw, seed.prior, seed.measured);
+
+			for (float dt : {0.f, 0.008f, 0.024f, 0.016f}) {
+				publish(to_fw, seed.measured);
+				ASSERT_TRUE(transition.updateInitialize());
+				transition.setDeltaTime(dt);
+				ASSERT_TRUE(transition.update());
+				last = transition.getTrajectorySetpoint();
+			}
+			ASSERT_TRUE(std::isfinite(last.acceleration[2]));
+			_vehicle_status.in_transition_mode = false;
+			_vehicle_status.vehicle_type = to_fw ? vehicle_status_s::VEHICLE_TYPE_FIXED_WING : vehicle_status_s::VEHICLE_TYPE_ROTARY_WING;
+			_status.publish(_vehicle_status);
+			AutoTestTask next;
+			ASSERT_TRUE(next.updateInitialize());
+			ASSERT_TRUE(next.activate(last));
+			ASSERT_TRUE(next.updateInitialize());
+			next.setDeltaTime(0.f);
+			ASSERT_TRUE(next.update());
+			auto sp = next.getTrajectorySetpoint();
+			EXPECT_FLOAT_EQ(sp.velocity[2], last.velocity[2]);
+			EXPECT_FLOAT_EQ(sp.acceleration[2], last.acceleration[2]);
+			EXPECT_NE(sp.acceleration[2], _position.az);
+
+			for (float dt : {0.008f, 0.024f, 0.016f, 0.f, 0.05f}) {
+				ASSERT_TRUE(next.updateInitialize());
+				next.setDeltaTime(dt);
+				ASSERT_TRUE(next.update());
+				sp = next.getTrajectorySetpoint();
+
+				for (size_t axis = 0; axis < 3; ++axis) {
+					EXPECT_TRUE(std::isfinite(sp.position[axis]));
+					EXPECT_TRUE(std::isfinite(sp.velocity[axis]));
+					EXPECT_TRUE(std::isfinite(sp.acceleration[axis]));
+				}
+
+				EXPECT_GE(sp.acceleration[2], -acceleration_up - 1e-5f);
+				EXPECT_LE(sp.acceleration[2], acceleration_down + 1e-5f);
+			}
+		}
+	}
+}
