+TEST_F(TransitionAccelerationTest, DerivativeAgreesWithNonzeroDtFilterStep)
+{
+	for (bool to_fw : {false, true}) {
+		for (float seed : {-0.9f, 0.f, 0.9f}) {
+			TransitionTestTask task;
+			auto previous = activate(task, to_fw, seed, 0.3f);
+
+			for (float dt : {0.008f, 0.024f, 0.016f, 0.05f, 0.2f, 0.f}) {
+				publish(to_fw, 0.3f);
+				ASSERT_TRUE(task.updateInitialize());
+				task.setDeltaTime(dt);
+				ASSERT_TRUE(task.update());
+				const auto current = task.getTrajectorySetpoint();
+
+				if (dt > 0.f) {
+					const float finite_difference = (current.velocity[2] - previous.velocity[2]) / dt;
+					EXPECT_NEAR(current.acceleration[2], finite_difference, 1e-5f);
+
+				} else {
+					EXPECT_FLOAT_EQ(current.velocity[2], previous.velocity[2]);
+					EXPECT_FLOAT_EQ(current.acceleration[2], previous.acceleration[2]);
+				}
+
+				previous = current;
+			}
+		}
+	}
+}
