+TEST_F(TransitionAccelerationTest, PlannedAccelerationBothDirectionsAndSeeds)
+{
+	for (bool to_fw : {false, true}) {
+		for (float seed : {-0.9f, 0.f, 0.9f, -FLT_MAX, FLT_MAX}) {
+			TransitionTestTask task;
+			auto sp = activate(task, to_fw, seed, 0.3f);
+
+			for (float dt : {0.f, 0.024f, 0.008f, 0.016f, 0.f}) {
+				publish(to_fw, 0.3f);
+				ASSERT_TRUE(task.updateInitialize());
+				task.setDeltaTime(dt);
+				ASSERT_TRUE(task.update());
+				sp = task.getTrajectorySetpoint();
+				EXPECT_TRUE(std::isfinite(sp.acceleration[2]));
+				EXPECT_FLOAT_EQ(sp.acceleration[2], -sp.velocity[2] / 2.f);
+				EXPECT_LE(std::fabs(sp.acceleration[2]), std::fabs(seed) / 2.f);
+			}
+		}
+	}
+}
