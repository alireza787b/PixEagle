+TEST_F(TransitionAccelerationTest, HighSpeedHandoverPreservesPlannedReferenceThroughPositionControl)
+{
+	float acceleration_up = 0.f;
+	float acceleration_down = 0.f;
+	float speed_up = 0.f;
+	float speed_down = 0.f;
+	ASSERT_EQ(param_get(param_find("MPC_ACC_UP_MAX"), &acceleration_up), 0);
+	ASSERT_EQ(param_get(param_find("MPC_ACC_DOWN_MAX"), &acceleration_down), 0);
+	ASSERT_EQ(param_get(param_find("MPC_Z_VEL_MAX_UP"), &speed_up), 0);
+	ASSERT_EQ(param_get(param_find("MPC_Z_VEL_MAX_DN"), &speed_down), 0);
+	ASSERT_GT(acceleration_up, 0.f);
+	ASSERT_GT(acceleration_down, 0.f);
+	constexpr float kVelocityTimeConstant = 2.f;
+	constexpr float kBoundaryOffset = 0.1f;
+	// The current defaults give acceleration-boundary speeds of +8 and -6 m/s.
+	const float descending_boundary = kVelocityTimeConstant * acceleration_up;
+	const float ascending_boundary = -kVelocityTimeConstant * acceleration_down;
+	const float seeds[] = {-speed_up, speed_down,
+			       ascending_boundary - kBoundaryOffset, ascending_boundary, ascending_boundary + kBoundaryOffset,
+			       descending_boundary - kBoundaryOffset, descending_boundary, descending_boundary + kBoundaryOffset
+			      };
+
+	for (bool to_fw : {false, true}) {
+		for (bool state_fallback : {false, true}) {
+			for (float seed : seeds) {
+				SCOPED_TRACE(seed);
+				SCOPED_TRACE(to_fw);
+				SCOPED_TRACE(state_fallback);
+				TransitionTestTask transition;
+				const auto last = activate(transition, to_fw, state_fallback ? NAN : seed, seed);
+				EXPECT_TRUE(std::isfinite(last.acceleration[2]));
+				EXPECT_LE(last.acceleration[2] * last.velocity[2], 0.f);
+				publishAuto(to_fw, seed);
+				AutoTestTask next;
+				ASSERT_TRUE(next.updateInitialize());
+				ASSERT_TRUE(next.activate(last));
+				ASSERT_TRUE(next.updateInitialize());
+				next.setDeltaTime(0.f);
+				ASSERT_TRUE(next.update());
+				auto setpoint = next.getTrajectorySetpoint();
+				// Handover must retain the planned reference rather than the measured impulse.
+				EXPECT_FLOAT_EQ(setpoint.acceleration[2], last.acceleration[2]);
+				EXPECT_NE(setpoint.acceleration[2], _position.az);
+				PositionControl controller;
+				configureController(controller);
+				runController(controller, setpoint);
+
+				for (float dt : {0.f, 0.008f, 0.024f, 0.016f, 0.05f}) {
+					publishAuto(to_fw, seed);
+					ASSERT_TRUE(next.updateInitialize());
+					next.setDeltaTime(dt);
+					ASSERT_TRUE(next.update());
+					setpoint = next.getTrajectorySetpoint();
+
+					for (float value : setpoint.acceleration) { EXPECT_TRUE(std::isfinite(value)); }
+
+					runController(controller, setpoint, dt);
+				}
+			}
+		}
+	}
+}
+
+TEST_F(TransitionAccelerationTest, HighSpeedThrustSaturationRecoversWithFreshStationaryHold)
+{
+	float acceleration_up = 0.f;
+	float acceleration_down = 0.f;
+	ASSERT_EQ(param_get(param_find("MPC_ACC_UP_MAX"), &acceleration_up), 0);
+	ASSERT_EQ(param_get(param_find("MPC_ACC_DOWN_MAX"), &acceleration_down), 0);
+	ASSERT_GT(acceleration_up, 0.f);
+	ASSERT_GT(acceleration_down, 0.f);
+	constexpr float kVelocityTimeConstant = 2.f;
+	constexpr float kBoundaryOffset = 0.1f;
+	constexpr float kSaturationVelocityGain = 20.f;
+	constexpr size_t kMaximumRecoverySteps = 250;
+	constexpr size_t kRequiredRecoveredSamples = 10;
+	const float descending_boundary = kVelocityTimeConstant * acceleration_up;
+	const float ascending_boundary = -kVelocityTimeConstant * acceleration_down;
+	const float seeds[] = {ascending_boundary - kBoundaryOffset, ascending_boundary,
+			       ascending_boundary + kBoundaryOffset, descending_boundary - kBoundaryOffset,
+			       descending_boundary, descending_boundary + kBoundaryOffset
+			      };
+
+	for (bool to_fw : {false, true}) {
+		for (bool state_fallback : {false, true}) {
+			for (float seed : seeds) {
+				SCOPED_TRACE(seed);
+				SCOPED_TRACE(to_fw);
+				SCOPED_TRACE(state_fallback);
+				TransitionTestTask transition;
+				const auto last = activate(transition, to_fw, state_fallback ? NAN : seed, seed);
+				publishAuto(to_fw, seed);
+				AutoTestTask next;
+				ASSERT_TRUE(next.updateInitialize());
+				ASSERT_TRUE(next.activate(last));
+				ASSERT_TRUE(next.updateInitialize());
+				next.setDeltaTime(0.f);
+				ASSERT_TRUE(next.update());
+				PositionControl controller;
+				configureController(controller, kSaturationVelocityGain);
+				const auto saturated = runController(controller, next.getTrajectorySetpoint());
+				EXPECT_NEAR(matrix::Vector3f(saturated.thrust).norm(),
+					    seed > 0.f ? kMaximumThrust : kMinimumThrust, kThrustTolerance);
+				size_t recovered_samples = 0;
+
+				for (size_t step = 0; step < kMaximumRecoverySteps; ++step) {
+					// Deterministic fresh observations, not a plant model or integrated commands.
+					publishAuto(to_fw, 0.f, true);
+					ASSERT_TRUE(next.updateInitialize());
+					next.setDeltaTime(kControllerDt);
+					ASSERT_TRUE(next.update());
+					const auto setpoint = next.getTrajectorySetpoint();
+					const auto output = runController(controller, setpoint);
+					const float thrust = matrix::Vector3f(output.thrust).norm();
+					const bool ordinary_reference = std::isfinite(setpoint.velocity[2])
+									&& fabsf(setpoint.velocity[2]) < 0.2f
+									&& std::isfinite(setpoint.acceleration[2])
+									&& setpoint.acceleration[2] >= -acceleration_up - kThrustTolerance
+									&& setpoint.acceleration[2] <= acceleration_down + kThrustTolerance;
+					const bool interior_thrust = thrust > kMinimumThrust + kThrustTolerance
+								     && thrust < kMaximumThrust - kThrustTolerance;
+					recovered_samples = ordinary_reference && interior_thrust ? recovered_samples + 1 : 0;
+
+					if (recovered_samples == kRequiredRecoveredSamples) { break; }
+				}
+
+				// The same task, controller and integrator survive both saturation and recovery.
+				EXPECT_EQ(recovered_samples, kRequiredRecoveredSamples);
+			}
+		}
+	}
+}
