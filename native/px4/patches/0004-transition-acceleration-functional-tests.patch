+TEST_F(TransitionAccelerationTest, ActivationAndReactivationResetPriorAxesAndGear)
+{
+	float speed_up = 0.f;
+	float speed_down = 0.f;
+	ASSERT_EQ(param_get(param_find("MPC_Z_VEL_MAX_UP"), &speed_up), 0);
+	ASSERT_EQ(param_get(param_find("MPC_Z_VEL_MAX_DN"), &speed_down), 0);
+
+	for (bool to_fw : {false, true}) {
+		TransitionTestTask task;
+
+		for (float seed : {0.9f, -0.9f, 0.f}) {
+			publish(to_fw, 0.3f);
+			auto prior = FlightTask::empty_trajectory_setpoint;
+
+			for (size_t axis = 0; axis < 3; ++axis) {
+				prior.position[axis] = 123.f;
+				prior.velocity[axis] = seed;
+				prior.acceleration[axis] = -99.f;
+				prior.jerk[axis] = 42.f;
+			}
+
+			prior.yaw = 1.f;
+			prior.yawspeed = 2.f;
+			ASSERT_TRUE(task.updateInitialize());
+			ASSERT_TRUE(task.activate(prior));
+			const auto activated = task.getTrajectorySetpoint();
+
+			for (size_t axis = 0; axis < 3; ++axis) {
+				EXPECT_TRUE(std::isnan(activated.position[axis]));
+				EXPECT_TRUE(std::isnan(activated.velocity[axis]));
+				EXPECT_TRUE(std::isnan(activated.acceleration[axis]));
+				EXPECT_TRUE(std::isnan(activated.jerk[axis]));
+			}
+
+			EXPECT_TRUE(std::isnan(activated.yaw));
+			EXPECT_TRUE(std::isnan(activated.yawspeed));
+			EXPECT_EQ(task.getGear().landing_gear, to_fw ? landing_gear_s::GEAR_UP : landing_gear_s::GEAR_DOWN);
+			EXPECT_FLOAT_EQ(task.getConstraints().speed_up, speed_up);
+			EXPECT_FLOAT_EQ(task.getConstraints().speed_down, speed_down);
+			EXPECT_FALSE(task.getConstraints().want_takeoff);
+			record("activated", to_fw, static_cast<size_t>(seed > 0.f ? 0 : seed < 0.f ? 1 : 2), activated);
+			task.setDeltaTime(0.f);
+			ASSERT_TRUE(task.update());
+			EXPECT_FLOAT_EQ(task.getTrajectorySetpoint().velocity[2], seed);
+		}
+	}
