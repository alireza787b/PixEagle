+protected:
+	void SetUp() override { param_control_autosave(false); }
+
+	uORB::Publication<vehicle_local_position_s> _local{ORB_ID(vehicle_local_position)};
+	uORB::Publication<vehicle_status_s> _status{ORB_ID(vehicle_status)};
+	uORB::Publication<home_position_s> _home{ORB_ID(home_position)};
+	uORB::Publication<position_setpoint_triplet_s> _triplet{ORB_ID(position_setpoint_triplet)};
+	uORB::Publication<takeoff_status_s> _takeoff{ORB_ID(takeoff_status)};
+	vehicle_local_position_s _position{};
+	vehicle_status_s _vehicle_status{};
+
+	void publish(bool to_fw, float measured_vz, bool valid_vz = true, bool stationary_hold = false)
+	{
+		const auto now = hrt_absolute_time();
+		_position.timestamp = now;
+		_position.timestamp_sample = now;
+		_position.xy_valid = true;
+		_position.z_valid = true;
+		_position.v_xy_valid = true;
+		_position.v_z_valid = valid_vz;
+		_position.xy_global = true;
+		_position.z_global = true;
+		_position.ref_timestamp = 1;
+		_position.ref_lat = 47.397742;
+		_position.ref_lon = 8.545594;
+		_position.ref_alt = 489.439f;
+		_position.x = 0.f;
+		_position.y = 0.f;
+		_position.z = -30.0585632f;
+		_position.vx = stationary_hold ? 0.f : 4.f;
+		_position.vy = stationary_hold ? 0.f : 1.f;
+		_position.vz = measured_vz;
+		_position.ax = 0.2f;
+		_position.ay = -0.1f;
+		_position.az = -4.75382137f;
+		_position.heading = 0.5f;
+		_position.heading_good_for_control = true;
+		_position.eph = 0.5f;
+		_local.publish(_position);
+		_vehicle_status.timestamp = now;
+		_vehicle_status.nav_state = vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER;
+		_vehicle_status.vehicle_type = vehicle_status_s::VEHICLE_TYPE_ROTARY_WING;
+		_vehicle_status.in_transition_mode = true;
+		_vehicle_status.in_transition_to_fw = to_fw;
+		_status.publish(_vehicle_status);
+		home_position_s home{};
+		home.timestamp = now;
+		home.valid_alt = true;
+		home.alt = 489.439f;
+		_home.publish(home);
+		position_setpoint_triplet_s triplet{};
+		triplet.timestamp = now;
+		triplet.current.valid = true;
+		triplet.current.type = position_setpoint_s::SETPOINT_TYPE_LOITER;
+		triplet.current.lat = _position.ref_lat;
+		triplet.current.lon = _position.ref_lon;
+		triplet.current.alt = stationary_hold ? _position.ref_alt - _position.z : 519.6014f;
+		triplet.current.yaw = NAN;
+		triplet.current.cruising_speed = NAN;
+		triplet.current.cruising_throttle = NAN;
+		triplet.current.acceptance_radius = NAN;
+		_triplet.publish(triplet);
+		takeoff_status_s takeoff{};
+		takeoff.timestamp = now;
+		takeoff.takeoff_state = takeoff_status_s::TAKEOFF_STATE_FLIGHT;
+		_takeoff.publish(takeoff);
+	}
+
+	void publishAuto(bool to_fw, float measured_vz, bool stationary_hold = false)
+	{
+		publish(to_fw, measured_vz, true, stationary_hold);
+		_vehicle_status.in_transition_mode = false;
+		_vehicle_status.vehicle_type = to_fw ? vehicle_status_s::VEHICLE_TYPE_FIXED_WING :
+					       vehicle_status_s::VEHICLE_TYPE_ROTARY_WING;
+		_status.publish(_vehicle_status);
+	}
+
+	static constexpr float kMinimumThrust = 0.1f;
+	static constexpr float kMaximumThrust = 0.9f;
+	static constexpr float kHoverThrust = 0.5f;
+	static constexpr float kThrustTolerance = 1e-5f;
+	static constexpr float kControllerDt = 0.016f;
+
+	void configureController(PositionControl &controller, float velocity_gain = 2.f)
+	{
+		// Fixture gains expose native thrust limits; no firmware parameter is changed.
+		controller.setPositionGains(matrix::Vector3f(1.f, 1.f, 1.f));
+		controller.setVelocityGains(matrix::Vector3f(velocity_gain, velocity_gain, velocity_gain),
+					    matrix::Vector3f(0.2f, 0.2f, 0.2f), matrix::Vector3f());
+		float speed_up = 0.f;
+		float speed_down = 0.f;
+		ASSERT_EQ(param_get(param_find("MPC_Z_VEL_MAX_UP"), &speed_up), 0);
+		ASSERT_EQ(param_get(param_find("MPC_Z_VEL_MAX_DN"), &speed_down), 0);
+		controller.setVelocityLimits(12.f, speed_up, speed_down);
+		controller.setThrustLimits(kMinimumThrust, kMaximumThrust);
+		controller.setHorizontalThrustMargin(0.3f);
+		controller.setTiltLimit(1.f);
+		controller.setHoverThrust(kHoverThrust);
+	}
+
+	vehicle_local_position_setpoint_s runController(PositionControl &controller,
+			const trajectory_setpoint_s &setpoint, float dt = kControllerDt)
+	{
+		controller.setState({matrix::Vector3f(_position.x, _position.y, _position.z),
+				     matrix::Vector3f(_position.vx, _position.vy, _position.vz),
+				     matrix::Vector3f(_position.ax, _position.ay, _position.az), _position.heading});
+		controller.setInputSetpoint(setpoint);
+		EXPECT_TRUE(controller.update(dt));
+		vehicle_local_position_setpoint_s output{};
+		vehicle_attitude_setpoint_s attitude{};
+		controller.getLocalPositionSetpoint(output);
+		controller.getAttitudeSetpoint(attitude);
+
+		for (size_t axis = 0; axis < 3; ++axis) {
+			EXPECT_TRUE(std::isfinite(output.acceleration[axis]));
+			EXPECT_TRUE(std::isfinite(output.thrust[axis]));
+			EXPECT_TRUE(std::isfinite(attitude.thrust_body[axis]));
+		}
+
+		for (float value : attitude.q_d) { EXPECT_TRUE(std::isfinite(value)); }
+
+		EXPECT_NEAR(matrix::Quatf(attitude.q_d).norm(), 1.f, kThrustTolerance);
+		const float thrust = matrix::Vector3f(output.thrust).norm();
+		EXPECT_GE(thrust, kMinimumThrust - kThrustTolerance);
+		EXPECT_LE(thrust, kMaximumThrust + kThrustTolerance);
+		EXPECT_LT(output.thrust[2], 0.f);
+		return output;
+	}
+
+	trajectory_setpoint_s activate(TransitionTestTask &task, bool to_fw, float prior_vz,
+				       float measured_vz, bool valid_vz = true)
+	{
+		publish(to_fw, measured_vz, valid_vz);
+		auto prior = FlightTask::empty_trajectory_setpoint;
+		prior.velocity[2] = prior_vz;
+		EXPECT_TRUE(task.updateInitialize());
+		EXPECT_TRUE(task.activate(prior));
+		task.setDeltaTime(0.f);
+		EXPECT_TRUE(task.update());
+		return task.getTrajectorySetpoint();
+	}
+
+	void record(const char *name, bool to_fw, size_t step, const trajectory_setpoint_s &sp)
+	{
+		const char *path = std::getenv("TRANSITION_CHARACTERIZATION");
+
+		if (!path) { return; }
+
+		FILE *file = std::fopen(path, "a");
+		ASSERT_NE(file, nullptr);
+		std::fprintf(file, "%s,%d,%zu", name, to_fw, step);
+
+		for (float value : sp.position) { std::fprintf(file, ",%a", static_cast<double>(value)); }
+
+		for (float value : sp.velocity) { std::fprintf(file, ",%a", static_cast<double>(value)); }
+
+		for (float value : sp.acceleration) { std::fprintf(file, ",%a", static_cast<double>(value)); }
+
+		for (float value : sp.jerk) { std::fprintf(file, ",%a", static_cast<double>(value)); }
+
+		std::fprintf(file, ",%a,%a\n", static_cast<double>(sp.yaw), static_cast<double>(sp.yawspeed));
+		std::fclose(file);
+	}
+};
+
+TEST_F(TransitionAccelerationTest, VelocityAndOtherAxesCharacterization)
+{
+	struct Seed { const char *name; float prior; float measured; bool valid; };
+	const Seed seeds[] = {
+		{"positive", 0.9f, 0.3f, true}, {"negative", -0.9f, -0.3f, true},
+		{"zero", 0.f, 0.5f, true}, {"prior_nan_positive", NAN, 0.4f, true},
+		{"prior_nan_negative", NAN, -0.4f, true}, {"prior_nan_zero", NAN, 0.f, true},
+		{"invalid_state", NAN, NAN, false}, {"finite_prior_invalid_state", 0.9f, NAN, false},
+		{"large_positive", FLT_MAX, 0.f, true}, {"large_negative", -FLT_MAX, 0.f, true}
+	};
+	const float dts[] = {0.f, 0.008f, 0.024f, 0.016f, 0.f, 0.05f, 0.2f};
+
+	for (bool to_fw : {false, true}) {
+		for (const auto &seed : seeds) {
+			SCOPED_TRACE(seed.name);
+			TransitionTestTask task;
+			activate(task, to_fw, seed.prior, seed.measured, seed.valid);
+			AlphaFilter<float> expected{2.f};
+			expected.reset(std::isfinite(seed.prior) ? seed.prior : seed.measured);
+
+			for (size_t step = 0; step < sizeof(dts) / sizeof(dts[0]); ++step) {
+				publish(to_fw, seed.measured, seed.valid);
+				ASSERT_TRUE(task.updateInitialize());
+				task.setDeltaTime(dts[step]);
+				ASSERT_TRUE(task.update());
+				const auto sp = task.getTrajectorySetpoint();
+				const float expected_vz = expected.update(0.f, dts[step]);
+
+				if (std::isfinite(expected_vz)) { EXPECT_FLOAT_EQ(sp.velocity[2], expected_vz); }
+
+				else { EXPECT_TRUE(std::isnan(sp.velocity[2])); }
+
+				EXPECT_TRUE(std::isnan(sp.yaw));
+				EXPECT_FLOAT_EQ(sp.yawspeed, 0.f);
+				record(seed.name, to_fw, step, sp);
+			}
+		}
+	}
+}
