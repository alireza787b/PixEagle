diff --git a/src/modules/commander/ExpectedModeGuard.hpp b/src/modules/commander/ExpectedModeGuard.hpp
new file mode 100644
index 0000000000..ce92c78a2b
--- /dev/null
+++ b/src/modules/commander/ExpectedModeGuard.hpp
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+namespace px4
+{
+
+inline bool matchesExpectedMode(uint8_t mode, uint64_t activated_at, float expected_mode, double expected_activation)
+{
+	if (!std::isfinite(expected_activation) || expected_activation <= 0.) {
+		return true;
+	}
+
+	// The command's double field represents integer microseconds exactly here.
+	constexpr double maximum_exact_integer = static_cast<double>(uint64_t{1} << 53);
+
+	if (!std::isfinite(expected_mode) || expected_mode < 0.f || expected_mode > UINT8_MAX
+	    || expected_activation > maximum_exact_integer) {
+		return false;
+	}
+
+	return static_cast<uint8_t>(lroundf(expected_mode)) == mode
+	       && static_cast<uint64_t>(llround(expected_activation)) == activated_at;
+}
+
+} // namespace px4
diff --git a/src/modules/commander/ExpectedModeGuardTest.cpp b/src/modules/commander/ExpectedModeGuardTest.cpp
new file mode 100644
index 0000000000..c9675f0685
--- /dev/null
+++ b/src/modules/commander/ExpectedModeGuardTest.cpp
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "ExpectedModeGuard.hpp"
+#include <gtest/gtest.h>
+#include <limits>
+
+TEST(ExpectedModeGuard, RetainsOrdinaryNativeModeRequests)
+{
+	EXPECT_TRUE(px4::matchesExpectedMode(23, 1000000, 0.f, 0.));
+	EXPECT_TRUE(px4::matchesExpectedMode(23, 1000000, NAN, NAN));
+}
+
+TEST(ExpectedModeGuard, RejectsDelayedHandoffAfterTakeoverOrModeReentry)
+{
+	EXPECT_TRUE(px4::matchesExpectedMode(23, 1000000, 23.f, 1000000.));
+	EXPECT_FALSE(px4::matchesExpectedMode(5, 1000000, 23.f, 1000000.));
+	EXPECT_FALSE(px4::matchesExpectedMode(23, 2000000, 23.f, 1000000.));
+	EXPECT_FALSE(px4::matchesExpectedMode(23, 1000000, NAN, 1000000.));
+	EXPECT_FALSE(px4::matchesExpectedMode(23, 1000000, 256.f, 1000000.));
+	EXPECT_FALSE(px4::matchesExpectedMode(23, 1000000, 23.f, std::numeric_limits<double>::max()));
+}
+
+TEST(ExpectedModeGuard, SupportsManualModeZeroAsAnExpectedState)
+{
+	EXPECT_TRUE(px4::matchesExpectedMode(0, 1000000, 0.f, 1000000.));
+	EXPECT_FALSE(px4::matchesExpectedMode(0, 1000001, 0.f, 1000000.));
+}
