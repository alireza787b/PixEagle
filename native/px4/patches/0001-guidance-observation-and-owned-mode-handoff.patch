+void FwLateralLongitudinalControl::publishGuidanceStatus(hrt_abstime now, bool active, float effective_airspeed)
+{
+	if (now - _last_guidance_status_publication < 100_ms) {
+		return;
+	}
+
+	fixed_wing_guidance_status_s status{};
+	status.timestamp = hrt_absolute_time();
+	status.timestamp_sample = now;
+	status.parameter_revision = _parameter_revision;
+	status.nav_state = _vehicle_status_sub.get().nav_state;
+	status.nav_state_timestamp = _vehicle_status_sub.get().nav_state_timestamp;
+	_home_position_sub.update();
+	status.home_altitude_amsl = _home_position_sub.get().alt;
+	status.home_update_count = _home_position_sub.get().update_count;
+	status.home_altitude_valid = _home_position_sub.get().valid_alt;
+	uuid_uint32_t uid;
+	board_get_uuid32(uid);
+	status.autopilot_uid = (static_cast<uint64_t>(uid[PX4_CPU_UUID_WORD32_UNIQUE_M]) << 32) | uid[PX4_CPU_UUID_WORD32_UNIQUE_H];
+#ifdef CONFIG_ARCH_BOARD_PX4_SITL
+	status.autopilot_uid += _vehicle_status_sub.get().system_id - 1;
+#endif
+	status.firmware_git_hash = px4_firmware_version_binary();
+	status.minimum_equivalent_airspeed = _performance_model.getMinimumCalibratedAirspeed(_load_factor_from_bank_angle, _flaps_setpoint);
+	status.trim_equivalent_airspeed = _performance_model.getCalibratedTrimAirspeed();
+	status.maximum_equivalent_airspeed = _performance_model.getMaximumCalibratedAirspeed();
+	status.climb_rate_limit = _performance_model.getMaximumClimbRate(_air_density);
+	status.sink_rate_limit = _param_fw_t_sink_max.get();
+	status.vertical_acceleration_limit = _param_fw_t_vert_acc.get();
+	status.altitude_response_time = _tecs_alt_time_const_slew_rate.getState();
+	status.bank_limit = radians(_param_fw_r_lim.get());
+	status.requested_equivalent_airspeed = active ? _long_control_sp.equivalent_airspeed : NAN;
+	status.effective_equivalent_airspeed = effective_airspeed;
+	status.airspeed_control_enabled = _param_fw_use_airspd.get() && _time_airspeed_last_valid != 0
+					  && hrt_elapsed_time(&_time_airspeed_last_valid) < 1_s;
+	status.observed_equivalent_airspeed = status.airspeed_control_enabled ? _long_control_state.airspeed_eas : NAN;
+	status.underspeed_ratio = active ? _tecs.get_underspeed_ratio() : NAN;
+	status.controller_active = active;
+	status.owner_bound_mode_changes_supported = true;
+	_guidance_status_pub.publish(status);
+	_last_guidance_status_publication = now;
+}
