+TEST_P(RegistrationTest, AutomaticUnregisterDefaultsAndExplicitOptOut)
+{
+  const std::string prefix = "/test_automatic_unregister/";
+  class InitializedRegistration : public Registration {
+   public:
+    InitializedRegistration(rclcpp::Node& node, const std::string& prefix)
+        : Registration(node, prefix)
+    {
+      setRegistrationDetails(1, 100, -1, "Automatic Test");
+    }
+  };
+  auto group = _node->create_callback_group(rclcpp::CallbackGroupType::MutuallyExclusive, false);
+  rclcpp::SubscriptionOptions options;
+  options.callback_group = group;
+  auto observer = _node->create_subscription<px4_msgs::msg::UnregisterExtComponent>(
+      prefix + "fmu/in/unregister_ext_component" +
+          px4_ros2::getMessageNameVersion<px4_msgs::msg::UnregisterExtComponent>(),
+      rclcpp::QoS(10), [](px4_msgs::msg::UnregisterExtComponent::UniquePtr) {}, options);
+  rclcpp::WaitSet wait_set;
+  wait_set.add_subscription(observer);
+  const auto receive = [&]() {
+    if (wait_set.wait(200ms).kind() != rclcpp::WaitResultKind::Ready) {
+      return false;
+    }
+    px4_msgs::msg::UnregisterExtComponent message;
+    rclcpp::MessageInfo info;
+    const bool taken = observer->take(message, info);
+    if (taken) {
+      EXPECT_EQ(message.mode_id, 100);
+      EXPECT_EQ(message.arming_check_id, 1);
+    }
+    return taken;
+  };
+  const auto ready = [&]() {
+    const auto deadline = std::chrono::steady_clock::now() + 2s;
+    auto event = _node->get_graph_event();
+    while (observer->get_publisher_count() == 0 && std::chrono::steady_clock::now() < deadline) {
+      _node->wait_for_graph_change(event, 50ms);
+    }
+    ASSERT_GT(observer->get_publisher_count(), 0u);
+  };
+
+  for (const bool enabled : {true, false}) {
+    auto registration = std::make_unique<InitializedRegistration>(*_node, prefix);
+    if (!enabled) {
+      registration->setAutomaticUnregister(false);
+    }
+    ready();
+    registration.reset();
+    EXPECT_EQ(receive(), enabled);  // Actual destructor publication.
+
+#if HAS_RCLCPP_PRE_SHUTDOWN
+    auto context = rclcpp::contexts::get_global_default_context();
+    const auto previous_callbacks = context->get_pre_shutdown_callbacks().size();
+    registration = std::make_unique<InitializedRegistration>(*_node, prefix);
+    if (!enabled) {
+      registration->setAutomaticUnregister(false);
+    }
+    ready();
+    const auto callbacks = context->get_pre_shutdown_callbacks();
+    ASSERT_EQ(callbacks.size(), previous_callbacks + 1);
+    callbacks.back()();  // The actual callback registered with rclcpp.
+    EXPECT_EQ(receive(), enabled);
+    EXPECT_EQ(registration->registered(), !enabled);
+    if (!enabled) {
+      registration->doUnregister();
+      EXPECT_TRUE(receive());  // Opt-out never suppresses explicit unregister.
+      EXPECT_FALSE(registration->registered());
+    }
+    registration.reset();
+    EXPECT_FALSE(receive());
+#endif
+  }
+  wait_set.remove_subscription(observer);
 }
 
